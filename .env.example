# ============================================
# PORTFOLIO ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing real secrets.

# --- Formspree ---
# Your Formspree form endpoint ID (from https://formspree.io)
FORMSPREE_FORM_ID=your_formspree_id_here

# --- Calendly ---
# Your Calendly consultation booking URL
CALENDLY_URL=https://calendly.com/your-username/consultation

# --- WhatsApp ---
# Your WhatsApp number (international format, no + or spaces)
WHATSAPP_NUMBER=201001234567

# --- Contact ---
# Your professional email address
CONTACT_EMAIL=contact@yourdomain.com

# --- Domain ---
# Your production domain
SITE_URL=https://yourdomain.com
